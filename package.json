{
  "name": "superjellycat-website",
  "version": "1.0.0",
  "type": "module",
  "description": "果冻猫侠工作室官网",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copy-assets.js && node scripts/fetch-taptap-stats.js",
    "dev": "npm run predev && vite",
    "prebuild": "node scripts/copy-assets.js && node scripts/fetch-taptap-stats.js",
    "build": "npm run prebuild && vite build",
    "build:check": "npm run prebuild && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "copy-assets": "node scripts/copy-assets.js",
    "fetch-taptap-stats": "node scripts/fetch-taptap-stats.js"
  },
  "dependencies": {
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.28",
    "sass": "^1.105.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  }
}
